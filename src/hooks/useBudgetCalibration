import { useMemo, useState } from "react";
import { useQuery } from "@tanstack/react-query";

import budgetCalibrationService
    from "../services/budgetCalibrationService";


function normalizeMonth(value) {

    if (!value)
        return null;

    const date =
        value instanceof Date
            ? value
            : new Date(value);

    return (
        `${date.getFullYear()}-${String(
            date.getMonth() + 1
        ).padStart(2, "0")}-01`
    );

}


export function useBudgetCalibration(targetMonth) {

    // ==========================================
    // PERIODI DISPONIBILI
    // ==========================================

    const normalizedTargetMonth =
        normalizeMonth(targetMonth);

    const periodsQuery =
        useQuery({

            queryKey: [
                "budget-calibration-periods"
            ],

            queryFn: () =>
                budgetCalibrationService
                    .getCalibrationPeriods()

        });

    const periods =
        periodsQuery.data ?? [];


    // ==========================================
    // ULTIMO MESE COMPLETO
    // ==========================================

    const lastCompletedMonth =
        useMemo(() => {

            const date =
                new Date();

            date.setDate(1);

            date.setMonth(
                date.getMonth() - 1
            );

            return (
                `${date.getFullYear()}-${String(
                    date.getMonth() + 1
                ).padStart(2, "0")}-01`
            );

        }, []);


    // ==========================================
    // PERIODI UTILIZZABILI
    // Solo mesi precedenti al target
    // ==========================================

    const availablePeriods =
        periods.filter(
            period =>
                period <=
                lastCompletedMonth &&
                (
                    !normalizedTargetMonth ||
                    period <
                    normalizedTargetMonth
                )
        );


    // ==========================================
    // FINE PERIODO DI ANALISI
    // ==========================================

    const analysisTo =
        availablePeriods.length > 0
            ? availablePeriods[
                availablePeriods.length - 1
            ]
            : null;


    // ==========================================
    // DEFAULT
    // ==========================================

    const defaultFrom =
        availablePeriods.length > 0
            ? availablePeriods[
                Math.max(
                    availablePeriods.length - 6,
                    0
                )
            ]
            : null;


    // ==========================================
    // STATO SLIDER
    // ==========================================

    const [
        calibrationFrom,
        setCalibrationFrom
    ] = useState(null);


    // ==========================================
    // PERIODO EFFETTIVO
    // ==========================================

    const from =
        calibrationFrom ??
        defaultFrom;


    const analysisPeriod =
        from && analysisTo
            ? {

                from,

                to:
                    analysisTo

            }
            : null;


    // ==========================================
    // CALIBRAZIONE
    // ==========================================

    const calibrationQuery =
        useQuery({

            queryKey: [
                "budget-calibration",
                analysisPeriod?.from,
                analysisPeriod?.to,
                normalizedTargetMonth
            ],

            queryFn: () =>
                budgetCalibrationService.getMetrics({

                    analysisPeriod,

                    targetMonth:
                        normalizedTargetMonth

                }),

            enabled:
                Boolean(analysisPeriod?.from) &&
                Boolean(normalizedTargetMonth),

            placeholderData:
                previousData =>
                    previousData

        });


    // ==========================================
    // RETURN
    // ==========================================

    return {

        periods:
            availablePeriods,

        calibrationFrom:
            from,

        calibrationTo:
            analysisTo,

        analysisPeriod,

        setCalibrationFrom,

        data:
            calibrationQuery.data,

        isLoading:
            periodsQuery.isLoading ||
            calibrationQuery.isLoading,

        error:
            periodsQuery.error ||
            calibrationQuery.error,

        targetMonth:
            normalizedTargetMonth

    };

}